---
import type { CollectionEntry } from 'astro:content';
import { categoryIcon } from '../data/categories';
import Icon from './Icon.astro';
interface Props { cases: CollectionEntry<'cases'>[]; }
const { cases } = Astro.props;
---
{cases.length ? <ul class="case-list">{cases.map(({ data: c }) => <li><a class="case-card" href={`/use-case/${c.slug}/`}><div class="card-title"><Icon name={categoryIcon(c.category)} size={26} /><h3>{c.title}</h3><Icon name="arrow" class="card-arrow" /></div><p>{c.summary}</p><div class="card-bottom"><span><Icon name="bot" size={18} />{c.agents.join(' / ')}</span><span class="step-meta"><Icon name="list" size={18} />{c.steps.length} 步</span></div></a></li>)}</ul> : <p class="empty">这里还没有用例，先去<a href="/">看看其他分类</a>。</p>}
